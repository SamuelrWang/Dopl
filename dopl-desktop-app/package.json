{
  "name": "dopl-desktop",
  "version": "1.1.0",
  "description": "Dopl — desktop app",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron scripts/smoke-test.js",
    "build": "electron-builder --mac",
    "dist": "electron-builder --mac",
    "release": "electron-builder --mac --publish always",
    "notarize": "bash scripts/finish-notarize.sh"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dopl.connect",
    "productName": "Dopl",
    "mac": {
      "icon": "build/icon.icns",
      "target": ["zip", "dmg"],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": false,
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.dopl.connect",
            "CFBundleURLSchemes": [
              "dopl"
            ]
          }
        ]
      }
    },
    "afterSign": "./scripts/notarize.js",
    "publish": [
      {
        "provider": "github",
        "owner": "SamuelrWang",
        "repo": "Dopl"
      }
    ],
    "dmg": {
      "title": "Dopl",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "main/**/*",
      "renderer/**/*"
    ]
  }
}
