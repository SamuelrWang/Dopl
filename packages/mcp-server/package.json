{
  "name": "@dopl/mcp-server",
  "version": "1.1.0",
  "description": "In-process MCP server engine for Dopl — booted by the web app's /api/mcp route. Internal workspace lib (not published to npm).",
  "private": true,
  "main": "dist/factory.js",
  "exports": {
    "./factory": {
      "types": "./dist/factory.d.ts",
      "default": "./dist/factory.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@dopl/client": "^0.13.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamuelrSun/usedopl.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/SamuelrSun/usedopl/tree/master/packages/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/SamuelrSun/usedopl/issues"
  },
  "keywords": [
    "dopl",
    "mcp",
    "knowledge-base",
    "claude-code",
    "agent"
  ]
