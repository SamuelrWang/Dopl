{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-p", "3000"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-p", "3014"],
      "port": 3014,
      "autoPort": false
    },
    {
      "name": "ui",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "DOPL_DEV_API_TARGET=http://localhost:3000 npm run dev:ui"],
      "port": 5173,
      "autoPort": false
    }
  ]
}
