      },
      {
        "name": "capability",
        "in": "query",
        "type": "string",
        "required": false,
        "description": null
      },
      {
        "name": "intent",
        "in": "query",
        "type": "\"message\" | \"ask\" | \"notify\" | \"display\"",
        "required": false,
        "description": null
      },
      {
        "name": "route",
        "in": "query",
        "type": "string",
        "required": false,
        "description": "The `route_decision.target` the call asked for (`auto`, a kind, a device id)."
      }
    ],
    "responses": [
      {
        "status": "200",
        "schema": "EventListResponse"
      },
      {
        "status": "400",
        "schema": null
      },
