  {
    "operationId": "deliver",
    "method": "POST",
    "path": "/users/{external_user_id}/deliver",
    "tag": "actions",
    "summary": "Deliver by intent; Dopl routes to a device (C5)",
    "auth": "secret",
    "params": [
      {
        "name": "external_user_id",
        "in": "path",
        "type": "string",
        "required": true,
        "description": "The developer's own id for the end user (no Dopl account, D1)."
      },
      {
        "name": "Idempotency-Key",
        "in": "header",
        "type": "string",
        "required": false,
        "description": "Optional on every POST. Where the body also carries `idempotency_key`, both must match; reusing a key with a different body is `idempotency_conflict`."
      },
      {
        "name": "Prefer",
        "in": "header",
        "type": "string",
        "required": false,
        "description": "`respond-async` (RFC 7240): do not hold an `ask` for its answer. The 202 returns at once with status `queued` or `delivered`; read the answer with GET /actions/{id} or the `action.completed` webhook. Other preferences are ignored."
      },
      {
        "name": "intent",
        "in": "body",
        "type": "\"message\" | \"ask\" | \"notify\" | \"display\"",
        "required": true,
        "description": null
      },
      {
        "name": "content",
        "in": "body",
        "type": "DeliverContent",
        "required": true,
        "description": null
      },
      {
        "name": "urgency",
        "in": "body",
        "type": "\"low\" | \"normal\" | \"high\"",
        "required": true,
        "description": null
      },
      {
        "name": "target",
        "in": "body",
        "type": "string",
        "required": false,
        "description": "`auto`, a device kind, or a device id."
      },
      {
        "name": "profile",
        "in": "body",
        "type": "string",
        "required": false,
        "description": null
      },
      {
        "name": "idempotency_key",
        "in": "body",
        "type": "string",
        "required": true,
        "description": null
      }
    ],
    "responses": [
      {
        "status": "202",
        "schema": "DeliverResponse"
      },
      {
        "status": "400",
        "schema": null
      },
      {
        "status": "401",
        "schema": null
      },
      {
        "status": "403",
        "schema": null
      },
      {
        "status": "404",
        "schema": null
      },
      {
        "status": "409",
        "schema": null
      },
      {
        "status": "429",
        "schema": null
      }
    ]
  },
