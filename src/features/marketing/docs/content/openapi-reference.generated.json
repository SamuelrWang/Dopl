    "method": "GET",
    "path": "/events",
    "tag": "events",
    "summary": "List this project's request log",
    "auth": "secret",
    "params": [
      {
        "name": "cursor",
        "in": "query",
        "type": "string",
        "required": false,
        "description": "Opaque. Pass back the `next_cursor` of the previous page, unchanged. Omit for the first page."
      },
      {
        "name": "limit",
        "in": "query",
        "type": "integer",
        "required": false,
        "description": "Items per page."
      },
      {
        "name": "since",
        "in": "query",
        "type": "string",
        "required": false,
        "description": "Oldest event to include. Defaults to 24 hours ago; at most 30 days ago."
      },
      {
        "name": "outcome",
        "in": "query",
        "type": "\"ok\" | \"error\" | \"denied\"",
        "required": false,
        "description": null
